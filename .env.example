# ============================================================
# Yui AI Assistant — variáveis de ambiente
# Copie para .env e preencha:  cp .env.example .env
# ============================================================

# --- Ambiente ------------------------------------------------
# "development" habilita conveniências (create_all, defaults tolerantes).
# Qualquer outro valor ativa as validações estritas de produção.
ENVIRONMENT=development

# --- Autenticação (OBRIGATÓRIO fora de development) ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Provedor de IA (defina a chave/config do provedor escolhido) ---
# LLM_PROVIDER: claude | openai | llama_cpp | ollama
# llama_cpp e ollama rodam 100% localmente — nenhuma API Key, nenhum
# acesso à internet no uso normal (após o modelo já estar no disco).
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Modelo utilitário: análise cognitiva pós-turno, adaptação e resumos
# rodam num modelo mais barato do mesmo provedor.
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5
OPENAI_UTILITY_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_HISTORY_CHARS=24000      # orçamento do histórico (~4 chars/token)
LLM_MAX_TOOL_ITERATIONS=5        # máximo de rodadas de ferramentas por turno

# --- Provedor utilitário: backend/modelo próprios (opcional) ---------
# Deixe em branco para o utilitário herdar o backend/modelo do principal
# (ANTHROPIC_UTILITY_MODEL/OPENAI_UTILITY_MODEL acima já cobrem esse caso
# para Claude/OpenAI). Só relevante para llama_cpp/ollama — permite, por
# exemplo, um modelo local pesado como principal e um modelo local menor
# e mais rápido como utilitário, ou até um backend diferente para cada um.
UTILITY_LLM_PROVIDER=
UTILITY_LLM_MODEL_PATH=
OLLAMA_UTILITY_MODEL=

# --- llama.cpp (inferência 100% local via arquivo .gguf) --------------
# Exige o extra opcional: pip install -r requirements-local-llama.txt
# (compila componentes nativos — veja esse arquivo para pré-requisitos).
# Ative com LLM_PROVIDER=llama_cpp e preencha:
LLM_MODEL_PATH=                  # ex.: models/qwen3-8b-instruct.Q4_K_M.gguf
LLM_CONTEXT_SIZE=8192
LLM_GPU_LAYERS=0                 # 0=CPU, -1=offload total, N=camadas específicas
LLM_THREADS=4
LLM_BATCH_SIZE=512
# Concorrência é SEMPRE travada em 1 nesta versão (sem isolamento de
# contexto por requisição) — este valor é ignorado se > 1, com aviso no
# log. Ver README para detalhes.
LLM_MAX_CONCURRENT_REQUESTS=1
# Chat format (ex.: "chatml", "chatml-function-calling", "functionary-v2").
# Vazio deixa a biblioteca detectar pelos metadados do GGUF. IMPORTANTE:
# só formatos com sufixo "-function-calling" (ou "functionary"/"functionary-v2")
# habilitam tool calling — "chatml" simples NUNCA habilita (default seguro).
LLM_CHAT_FORMAT=
# Defina true/false apenas se você validou manualmente o suporte a tool
# calling do modelo — sobrescreve a detecção acima.
LLM_SUPPORTS_TOOL_CALLING=

# --- Ollama (inferência 100% local via servidor HTTP) -----------------
# Exige uma instância do Ollama instalada e em execução (`ollama serve`).
# Ative com LLM_PROVIDER=ollama e preencha:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=                    # ex.: qwen3:8b (baixe antes com: ollama pull qwen3:8b)
OLLAMA_TIMEOUT_SECONDS=120
# Default é FALSE para qualquer modelo — nenhum modelo Ollama é presumido
# capaz de tool calling automaticamente. Defina true apenas após validar
# manualmente que o modelo escolhido suporta.
OLLAMA_SUPPORTS_TOOL_CALLING=

# --- Embeddings / memória semântica (RAG) --------------------
# EMBEDDING_PROVIDER: openai | sentence_transformers | disabled
# "disabled" mantém a busca lexical — a Yui funciona sem nenhum provedor
# de embeddings, local ou comercial.
# "sentence_transformers" roda 100% localmente (CPU por padrão); exige o
# extra opcional: pip install -r requirements-local-embeddings.txt
# O primeiro uso de um modelo baixa os pesos do Hugging Face Hub; usos
# seguintes funcionam offline.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small   # ou ex.: BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu                     # cpu | cuda | mps (sentence_transformers)
MEMORY_SIMILARITY_THRESHOLD=0.35
MEMORY_DUPLICATE_THRESHOLD=0.90

# --- Inteligência pós-turno (rodam em background) ------------
MEMORY_EXTRACTION_ENABLED=true   # extração automática de memórias
MEMORY_MIN_CONFIDENCE=0.6
SUMMARIZATION_ENABLED=true       # resumo de conversas longas

# --- Núcleo cognitivo (v0.3) ---------------------------------
CURIOSITY_ENABLED=true           # perguntas de curiosidade (máx. 1/turno)
CURIOSITY_MIN_INTERACTIONS=3
PLAN_STALE_DAYS=7                # plano parado há N dias desperta curiosidade
ADAPTATION_MAX_NOTES=12          # teto de notas de adaptação por usuário
MEMORY_MAINTENANCE_INTERVAL=20   # manutenção de memória a cada N interações
MEMORY_PRUNE_MIN_AGE_DAYS=30
MEMORY_PRUNE_SCORE_THRESHOLD=0.15

# --- Núcleo autônomo (v0.4) ----------------------------------
GOAL_ABANDONED_DAYS=21           # plano parado além disso = abandonado
# Attention Manager — pesos do Attention Score (determinístico)
ATTENTION_GOAL_WEIGHT=0.30
ATTENTION_RELATIONSHIP_WEIGHT=0.15
ATTENTION_PREFERENCE_WEIGHT=0.10
ATTENTION_GRAPH_WEIGHT=0.15
ATTENTION_REDUNDANCY_PENALTY=0.50
# Context Orchestrator — orçamento por bloco (chars; ~4/token)
CTX_BUDGET_SELF_CHARS=800
CTX_BUDGET_WORLD_CHARS=600
CTX_BUDGET_GOALS_CHARS=1200
CTX_BUDGET_ADAPTATION_CHARS=1200
CTX_BUDGET_SUMMARY_CHARS=2400
CTX_BUDGET_MEMORIES_CHARS=4000
# Autonomia — Judgement Engine / Bússola Moral
AUTONOMY_ENABLED=true
MORAL_ACT_THRESHOLD=0.45
MORAL_CONFIDENCE_THRESHOLD=0.55
MORAL_HIGH_RISK_THRESHOLD=0.70

# --- Companion Core (v0.5) -----------------------------------
AFFECT_ENABLED=true              # estado afetivo computacional persistente
CTX_BUDGET_AFFECT_CHARS=400
INITIATIVE_GENERATION_ENABLED=true  # registro de iniciativas no pós-turno
INITIATIVE_COOLDOWN_DAYS=14      # mesma situação não é reproposta na janela
INITIATIVE_MAX_PENDING=2         # teto de pendentes — iniciativas são raras
CURIOSITY_MIN_GAP_INTERACTIONS=4 # silêncio entre perguntas de curiosidade

# --- Ferramentas ---------------------------------------------
WEB_SEARCH_ENABLED=false         # habilita a ferramenta web_search

# --- Banco de dados ------------------------------------------
DATABASE_URL=postgresql+asyncpg://yui:yui_password@localhost:5432/yui
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

# --- Redis ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Memória -------------------------------------------------
SHORT_TERM_MAX_MESSAGES=20       # deve ser PAR (pares usuário/assistente)
SHORT_TERM_TTL_SECONDS=86400
MEMORY_RETRIEVAL_LIMIT=5

# --- Rate limiting / custos (plano "free") -------------------
RATE_LIMIT_CHAT_PER_MINUTE=20
DAILY_TOKEN_LIMIT=200000
RATE_LIMIT_AUTH_PER_MINUTE=10    # tentativas de login/registro por IP/minuto

# --- CORS ----------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
