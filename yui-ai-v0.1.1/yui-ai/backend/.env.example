# ============================================================
# Yui AI Assistant — variáveis de ambiente
# Copie para .env e preencha:  cp .env.example .env
# ============================================================

# --- Ambiente ------------------------------------------------
# "development" habilita conveniências (create_all, defaults tolerantes).
# Qualquer outro valor ativa as validações estritas de produção.
ENVIRONMENT=development

# --- Autenticação (OBRIGATÓRIO fora de development) ----------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Provedor de IA (defina a chave do provedor escolhido) ---
LLM_PROVIDER=claude              # claude | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Modelo utilitário: análise cognitiva pós-turno, adaptação e resumos
# rodam num modelo mais barato do mesmo provedor.
ANTHROPIC_UTILITY_MODEL=claude-haiku-4-5
OPENAI_UTILITY_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_HISTORY_CHARS=24000      # orçamento do histórico (~4 chars/token)
LLM_MAX_TOOL_ITERATIONS=5        # máximo de rodadas de ferramentas por turno

# --- Embeddings / memória semântica (RAG) --------------------
# "openai" habilita busca semântica (exige OPENAI_API_KEY);
# "disabled" mantém a busca lexical — a Yui funciona só com Claude.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_SIMILARITY_THRESHOLD=0.35
MEMORY_DUPLICATE_THRESHOLD=0.90

# --- Inteligência pós-turno (rodam em background) ------------
MEMORY_EXTRACTION_ENABLED=true   # extração automática de memórias
MEMORY_MIN_CONFIDENCE=0.6
SUMMARIZATION_ENABLED=true       # resumo de conversas longas

# --- Núcleo cognitivo (v0.3) ---------------------------------
CURIOSITY_ENABLED=true           # perguntas de curiosidade (máx. 1/turno)
CURIOSITY_MIN_INTERACTIONS=3
PLAN_STALE_DAYS=7                # plano parado há N dias desperta curiosidade
ADAPTATION_MAX_NOTES=12          # teto de notas de adaptação por usuário
MEMORY_MAINTENANCE_INTERVAL=20   # manutenção de memória a cada N interações
MEMORY_PRUNE_MIN_AGE_DAYS=30
MEMORY_PRUNE_SCORE_THRESHOLD=0.15

# --- Ferramentas ---------------------------------------------
WEB_SEARCH_ENABLED=false         # habilita a ferramenta web_search

# --- Banco de dados ------------------------------------------
DATABASE_URL=postgresql+asyncpg://yui:yui_password@localhost:5432/yui
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

# --- Redis ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Memória -------------------------------------------------
SHORT_TERM_MAX_MESSAGES=20       # deve ser PAR (pares usuário/assistente)
SHORT_TERM_TTL_SECONDS=86400
MEMORY_RETRIEVAL_LIMIT=5

# --- Rate limiting / custos (plano "free") -------------------
RATE_LIMIT_CHAT_PER_MINUTE=20
DAILY_TOKEN_LIMIT=200000

# --- CORS ----------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
