# ============================================================
# CONFIGURAÇÃO PARA EXECUÇÃO LOCAL (OLLAMA)
# ============================================================

ENVIRONMENT=development

JWT_SECRET_KEY=dev-secret-change-later-123456789

# ---------- LLM ----------
LLM_PROVIDER=ollama
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_HISTORY_CHARS=24000
LLM_MAX_TOOL_ITERATIONS=5

# ---------- Modelo utilitário ----------
UTILITY_LLM_PROVIDER=ollama
UTILITY_LLM_MODEL_PATH=
OLLAMA_UTILITY_MODEL=qwen3:4b

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_SUPPORTS_TOOL_CALLING=true

# ---------- Embeddings ----------
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ---------- Pós-turno ----------
MEMORY_EXTRACTION_ENABLED=false
SUMMARIZATION_ENABLED=false

# ---------- Companion Core ----------
CURIOSITY_ENABLED=false
AUTONOMY_ENABLED=false
AFFECT_ENABLED=false
INITIATIVE_GENERATION_ENABLED=false

# ---------- Ferramentas ----------
WEB_SEARCH_ENABLED=false

# ---------- Banco ----------
DATABASE_URL=postgresql+asyncpg://yui:yui_password@localhost:5432/yui

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0